{
  "name": "gym-notes",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "description": "Aplicativo Android de anotações de musculação: treinos, execução com cronômetro de descanso, histórico e evolução de cargas, 100% offline.",
  "license": "MIT",
  "dependencies": {
    "@expo/ui": "~57.0.24",
    "expo": "~57.0.29",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.27",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-reorderable-list": "^0.18.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/test/global-setup.js",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^expo-sqlite$": "<rootDir>/test/mocks/expo-sqlite.ts",
      "^expo-crypto$": "<rootDir>/test/mocks/expo-crypto.ts"
    },
    "collectCoverageFrom": [
      "src/database/**/*.ts",
      "src/features/**/{services,repositories,utils}/**/*.ts",
      "src/utils/**/*.ts",
      "src/components/charts/scale.ts"
    ]
  }
}
